# usage: cmake -DTNFS=<exe> -DREPO=<repository> -DWORK=<scratch dir> -P follow_car_settle.cmake
# Studio's Race photo of a traffic car (TNFS_FOLLOW_CAR): a traffic car is parked high above the track (ai_parked.c) until the player comes near, so a frame at a fixed tick
# can show the empty road from up there. With TNFS_FOLLOW_SETTLE=N the frame waits, past --node, until the followed car has been on the road N ticks. Coastal 1 with the
# draw 11112 has the Jetta in slot 6, parked at tick 800 and on the road later.
include("${CMAKE_CURRENT_LIST_DIR}/unique_work.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/user")
file(WRITE "${WORK}/user/port.cfg" "profile=restomod\n")
set(env SDL_VIDEO_DRIVER=dummy SDL_RENDER_DRIVER=software SDL_AUDIO_DRIVER=dummy ASAN_OPTIONS=detect_leaks=0 TNFS_VIEW=3 TNFS_FOLLOW_CAR=6 TNFS_DRIVE_SEED=11112)
set(args --data ${REPO}/original --user ${WORK}/user --drive CL1 --car 0 --type 1 --node 800 --screenshot ${WORK}/f.ppm)
# without the wait: the frame at tick 800, the Jetta parked, and the line says so
execute_process(COMMAND ${CMAKE_COMMAND} -E env ${env} ${TNFS} ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "the run failed (${rc}): ${err}")
endif()
if(NOT out MATCHES "follow: slot 6 is parked off the road at the frame")
    message(FATAL_ERROR "no line saying the followed car is parked at tick 800: ${out}")
endif()
# with the wait: the frame comes once the Jetta has been on the road 64 ticks, and the camera is at it (its eye node is not the parked car's 0)
execute_process(COMMAND ${CMAKE_COMMAND} -E env ${env} TNFS_FOLLOW_SETTLE=64 ${TNFS} ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "the run with the wait failed (${rc}): ${err}")
endif()
if(NOT out MATCHES "follow: slot 6 on the road from tick ([0-9]+), the frame at tick ([0-9]+)")
    message(FATAL_ERROR "no line saying when the followed car came out on the road: ${out}")
endif()
math(EXPR settled "${CMAKE_MATCH_2} - ${CMAKE_MATCH_1}")
if(CMAKE_MATCH_1 LESS 800 OR NOT settled EQUAL 64)
    message(FATAL_ERROR "the frame is not 64 ticks after the car came out past tick 800: ${CMAKE_MATCH_1} ${CMAKE_MATCH_2}")
endif()
if(NOT out MATCHES "eye node ([0-9]+)" OR CMAKE_MATCH_1 EQUAL 0)
    message(FATAL_ERROR "the camera is not at the followed car: ${out}")
endif()
file(REMOVE_RECURSE "${WORK}")
