# The groups of tracks that car_lit_all_game and track_light_fingerprint run side by side (CMakeLists.txt) hold every track of data/track_light exactly once: a track in no group would be skipped in silence.
# usage: cmake -DTRACKS="AL1 AL2 ..." -DDIR=<data/track_light> -P tests/track_groups.cmake
separate_arguments(grouped UNIX_COMMAND "${TRACKS}")
file(GLOB files "${DIR}/*.txt")
set(present "")
foreach(file IN LISTS files)
    get_filename_component(track "${file}" NAME_WE)
    list(APPEND present "${track}")
endforeach()
if(NOT present)
    message(FATAL_ERROR "no light files in ${DIR}")
endif()
set(once ${grouped})
list(REMOVE_DUPLICATES once)
list(LENGTH grouped n_grouped)
list(LENGTH once n_once)
if(NOT n_grouped EQUAL n_once)
    message(FATAL_ERROR "a track is in two groups: ${grouped}")
endif()
list(SORT once)
list(SORT present)
if(NOT once STREQUAL present)
    message(FATAL_ERROR "the groups are not the tracks of ${DIR}\n groups: ${once}\n files: ${present}")
endif()
