# usage: cmake -DTNFS=<exe> -DREPO=<repository> -DWORK=<scratch dir> -P input_script_shot.cmake
# The scripted input's SHOT (input_script.c): N:SHOT:name waits for the screen to be still, as a click does, and writes the frame on screen as
# TNFS_SHOT_DIR/name.ppm (a PPM of the frame's size), logging "input script: shot name"; several in one run, with no TNFS_CAPTURE_DIR. A name is
# 1..15 of a-z 0-9 _ - (no path): anything else is not a step. A SHOT just after a pointer move shows the move (the step before it drawn).
include("${CMAKE_CURRENT_LIST_DIR}/unique_work.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/user" "${WORK}/pref" "${WORK}/shots")
set(to_title "1500:ESC,0:WAIT:mark:movie=:20,500:ESC,0:WAIT:mark:screen=title:20")
execute_process(COMMAND ${CMAKE_COMMAND} -E env TNFS_PREF_DIR=${WORK}/pref SDL_VIDEO_DRIVER=dummy SDL_AUDIO_DRIVER=dummy ASAN_OPTIONS=detect_leaks=0 TNFS_BANDS=0
                        TNFS_INPUT_SETTLE=300 TNFS_SHOT_DIR=${WORK}/shots
                        "TNFS_INPUT_SCRIPT=${to_title},0:SHOT:title,300:ESC,0:WAIT:mark:screen=game_mode:20,0:SHOT:game_mode,300:MOUSE:100:400,0:SHOT:moved,0:SHOT:../out,0:WAIT:mark:never:3"
                        ${TNFS} --data ${REPO}/original --user ${WORK}/user
                RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err TIMEOUT 120)
if(NOT rc EQUAL 3)
    message(FATAL_ERROR "expected status 3 (the last WAIT), got ${rc}: ${err}")
endif()
file(READ "${WORK}/user/spirited-drive.log" log)
foreach(name title game_mode moved)
    if(NOT EXISTS "${WORK}/shots/${name}.ppm")
        message(FATAL_ERROR "no ${name}.ppm: ${log}")
    endif()
    file(READ "${WORK}/shots/${name}.ppm" head LIMIT 15)
    if(NOT head STREQUAL "P6\n640 480\n255\n")
        message(FATAL_ERROR "${name}.ppm is not a 640x480 PPM: '${head}'")
    endif()
    file(SIZE "${WORK}/shots/${name}.ppm" size)
    if(NOT size EQUAL 921615)
        message(FATAL_ERROR "${name}.ppm is ${size} bytes, not 15 + 640 x 480 x 3")
    endif()
    string(FIND "${log}" "input script: shot ${name}\n" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "the log does not say the shot ${name}: ${log}")
    endif()
endforeach()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${WORK}/shots/title.ppm" "${WORK}/shots/game_mode.ppm" RESULT_VARIABLE same)
if(same EQUAL 0)
    message(FATAL_ERROR "the title's shot and Game Mode's are the same picture")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${WORK}/shots/game_mode.ppm" "${WORK}/shots/moved.ppm" RESULT_VARIABLE same)
if(same EQUAL 0)
    message(FATAL_ERROR "the shot after a pointer move is the picture from before it")
endif()
if(EXISTS "${WORK}/out.ppm")
    message(FATAL_ERROR "a shot's name led out of TNFS_SHOT_DIR")
endif()
string(FIND "${log}" "bad TNFS_INPUT_SCRIPT item '0:SHOT:../out'" at)
if(at EQUAL -1)
    message(FATAL_ERROR "a shot's name with a path was not refused: ${log}")
endif()
file(REMOVE_RECURSE "${WORK}")
