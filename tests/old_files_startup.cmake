# usage: cmake -DTNFS=<exe> -DREPO=<repository> -DWORK=<scratch dir> -P old_files_startup.cmake
# The real program with an old custom port.cfg and extras.cfg: after one run they have moved to restomod.cfg, with their copies. test_port_old_files has the cases; this is the wiring.
include("${CMAKE_CURRENT_LIST_DIR}/unique_work.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/user" "${WORK}/pref")
set(old_port "profile=custom\ncamera_kind=3\nlaps=5\n")
set(old_extras "nitro=1\n")
file(WRITE "${WORK}/user/port.cfg" "${old_port}")
file(WRITE "${WORK}/user/extras.cfg" "${old_extras}")
execute_process(COMMAND ${CMAKE_COMMAND} -E env TNFS_PREF_DIR=${WORK}/pref SDL_VIDEO_DRIVER=dummy SDL_AUDIO_DRIVER=dummy ASAN_OPTIONS=detect_leaks=0 TNFS_FRAMES=1 TNFS_AUTOPILOT=1 TNFS_BANDS=0
                        ${TNFS} --data ${REPO}/original --user ${WORK}/user --drive TR1 --node 100 --screenshot ${WORK}/shot.ppm
                RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "the run failed (${rc})")
endif()
file(READ "${WORK}/user/port.cfg" port)
if(NOT port STREQUAL "profile=restomod\npsx_dir=\n")
    message(FATAL_ERROR "port.cfg: ${port}")
endif()
file(READ "${WORK}/user/restomod.cfg" mode)
foreach(line "camera_kind=3" "laps=5" "nitro=1")
    string(FIND "${mode}" "${line}\n" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "restomod.cfg lacks ${line}: ${mode}")
    endif()
endforeach()
file(READ "${WORK}/user/port.cfg.bak" copy)
file(READ "${WORK}/user/extras.cfg.bak" extras_copy)
if(NOT copy STREQUAL old_port OR NOT extras_copy STREQUAL old_extras)
    message(FATAL_ERROR "the copies differ from the old files")
endif()
if(EXISTS "${WORK}/user/extras.cfg")
    message(FATAL_ERROR "extras.cfg is still there")
endif()
file(REMOVE_RECURSE "${WORK}")
