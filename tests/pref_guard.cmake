# Every registered test runs with TNFS_PREF_DIR set to a scratch folder in the build, so none can reach the player's own folder (~/Library/Application Support/TNFS Restomod/ and its
# kin) by default: a tnfs started with no --user writes its log, its settings and a Replay.rpl there (found 2026-11-10: a gate had rewritten the real Replay.rpl and tnfs.log).
# usage: cmake -DCTEST=ctest -DBUILD=<build dir> [-DVAR=TNFS_PREF_DIR] -P pref_guard.cmake
if(NOT DEFINED VAR)
    set(VAR TNFS_PREF_DIR)
endif()
execute_process(COMMAND ${CTEST} --test-dir ${BUILD} --show-only=json-v1 OUTPUT_VARIABLE json RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "ctest --show-only failed (${rc})")
endif()
string(JSON count LENGTH "${json}" tests)
if(count LESS 100)
    message(FATAL_ERROR "only ${count} tests listed: the listing is not the suite's")
endif()
set(missing "")
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON name GET "${json}" tests ${i} name)
    set(found 0)
    string(JSON props ERROR_VARIABLE err GET "${json}" tests ${i} properties)
    if(NOT err)
        string(JSON pcount LENGTH "${props}")
        math(EXPR plast "${pcount} - 1")
        foreach(j RANGE ${plast})
            string(JSON pname GET "${props}" ${j} name)
            if(pname STREQUAL "ENVIRONMENT")
                string(JSON env GET "${props}" ${j} value)
                string(JSON ecount LENGTH "${env}")
                math(EXPR elast "${ecount} - 1")
                foreach(k RANGE ${elast})
                    string(JSON entry GET "${env}" ${k})
                    if(entry MATCHES "^${VAR}=${BUILD}/")
                        set(found 1)
                    endif()
                endforeach()
            endif()
        endforeach()
    endif()
    if(NOT found)
        list(APPEND missing ${name})
    endif()
endforeach()
if(missing)
    message(FATAL_ERROR "tests with no ${VAR}=<build>/... in their environment: ${missing}")
endif()
message(STATUS "pref_guard: all ${count} tests have ${VAR} in the build")
